# Port for the web dashboard and the SMS webhook
PORT=3000
# Public URL Twilio will call (used to verify webhook signatures). e.g. https://textchain.example.com
PUBLIC_URL=http://localhost:3000
# Password for the organizer dashboard
ADMIN_PASSWORD=change-me
# "sim" (no real texts; use the phone simulator at /sim) or "twilio"
SMS_PROVIDER=sim
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Where the SQLite database lives
DATABASE_PATH=./data/textchain.db
